<div class="row gx-4 gy-4">
  <div class="col-lg-12">

    <!-- HERO -->
    <section class="hero-section mb-5 text-center">
      <div class="hero p-5 rounded-3 text-white">
        <h1 class="display-6 fw-bold">¿Sabías qué?</h1>
        <p class="lead">
          Bienestar Universitario tiene como propósito principal brindar acompañamiento a la comunidad estudiantil a
          través de diversas estrategias, con el fin de promover su formación y desarrollo integral, así como incentivar su permanencia
          y graduación. Además, procura el desarrollo humano e integral de todos los actores de la comunidad académica,
          concibiendo estos procesos como un mejoramiento continuo que busca garantizar el bienestar de cada persona
          vinculada a la CUL y satisfacer sus necesidades de manera integral.
        </p>
      </div>
    </section>

    <!-- BANNER SIN PARALLAX -->
    <section class="banner-section mb-0 text-center">
      <div class="banner">
        <div class="banner-overlay d-flex justify-content-center align-items-center">
          <h2 class="text-white fw-bold">¡Bienvenido a Bienestar Universitario!</h2>
        </div>
      </div>
    </section>

    <hr>
    <!-- SUBTEXTO DEBAJO DEL BANNER -->
    <section class="info-section text-center text-white">
      <p class="lead mb-0">
        Conoce nuestras líneas de acción, estrategias, actividades y servicios que el Departamento de Bienestar
        Universitario ha pensado para ti
      </p>
    </section>

    <!-- TARJETAS -->
    <section class="cards-section mb-5 text-center">
      <div class="cards-container">
        <% const cards = [
          { img: '/static/img/ficha_permanencia.png', title: 'Permanencia y Graduación', text: 'El proceso de permanencia y graduación de la Corporación Universitaria Latinoamericana (CUL) trabaja en el diseño y ejecución de estrategias para acompañar al estudiante en su paso por la institución, fomentando la culminación exitosa de sus estudios.', link: '/permanencia' },
          { img: '/static/img/ficha_deporte.png', title: 'Deporte y Recreación', text: 'Desde la Vicerrectoría de Bienestar Universitario, el área de Deporte y Recreación fomenta la actividad física y el uso del tiempo libre como parte integral del bienestar estudiantil.', link: '/deporte' },
          { img: '/static/img/ficha_cultura.png', title: 'Cultura', text: 'El área de Cultura promueve espacios de expresión artística, creatividad e identidad institucional a través de talleres, grupos y eventos culturales.', link: '/cultura' },
          { img: '/static/img/ficha_salud.png', title: 'Salud', text: 'El proceso de Salud del Departamento de Bienestar Universitario vela por la atención integral y el bienestar físico y mental de nuestra comunidad universitaria.', link: '/salud' },
          { img: '/static/img/ficha_inclusion.png', title: 'Inclusión', text: 'Promovemos la igualdad, el respeto y la accesibilidad para todos los miembros de la comunidad educativa.', link: '/inclusion' }
        ]; %>

        <% cards.forEach(card => { %>
          <div class="flip-card">
            <div class="flip-card-inner">
              <div class="flip-card-front">
                <img src="<%= card.img %>" class="img-fluid rounded shadow" alt="<%= card.title %>">
                <div class="card-title-overlay">
                  <h6><%= card.title %></h6>
                </div>
              </div>
              <div class="flip-card-back d-flex flex-column justify-content-between align-items-center p-3"
                style="--bg-img: url('<%= card.img %>'); background-image: var(--bg-img);">
                <div>
                  <h6 class="fw-bold mb-2"><%= card.title %></h6>
                  <p class="small"><%= card.text %></p>
                </div>
                <a class="btn btn-outline-light btn-sm mt-2" href="<%= card.link %>">Leer más</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <hr>

    <!-- ACTIVIDADES -->
    <section class="activities-section text-center mt-5">
      <h3 class="mb-4 fw-bold">Actividades de Bienestar</h3>
      <ul class="list-unstyled d-inline-block text-start">
        <li class="mb-3">
          <a href="#" class="d-flex align-items-center text-decoration-none">
            <img src="/static/img/post1.jpg" width="120" class="me-3 rounded shadow-sm" alt="Actividad 1">
            <div>
              <strong>Jornada de inducción 2025-1</strong><br>
              <small class="text-muted">06 Agosto 2025</small>
            </div>
          </a>
        </li>
      </ul>

      <div class="row justify-content-center mt-4 gx-4 gy-3">
        <div class="col-md-5">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title">Próximos eventos</h5>
              <ul class="mb-0">
                <li>Festival de Teatro Universitario</li>
                <li>Exposición de Arte UL</li>
                <li>Concierto de Talentos</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="col-md-5">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h6>Contáctanos</h6>
              <p class="mb-0">
                Bienestar Universitario - Ext. 1234<br>
                bienestar@ul.edu.co
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>
