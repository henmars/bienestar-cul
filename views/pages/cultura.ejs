<div class="theme-cultura">
  <div class="container-fluid cultura-page py-4">
    <div class="row gx-5">

      <!-- IMPORTAR SIDEBAR -->
      <div class="col-md-3 col-lg-2">
        <%- include('../partials/sidebar', { activePage: 'cultura', themeClass: 'theme-cultura' }) %>
      </div>

      <!-- CONTENIDO PRINCIPAL -->
      <main class="col-md-9 col-lg-10 cultura-content">

        <!-- BANNER -->
        <section class="cultura-banner mb-4">
          <img src="/static/img/banner_cultura.jpg" class="img-fluid rounded shadow" alt="Banner Cultura">
        </section>

        <!-- TEXTO PRINCIPAL -->
        <section class="cultura-text">
          <p>
            Desde el eje de Bienestar Integral, en su área de <strong>Cultura</strong>, promovemos el arte y las expresiones culturales,
            a través de actividades y eventos artísticos fortaleciendo la identidad cultural, la creatividad, la autoestima y las habilidades
            comunicativas, formando profesionales sensibles, expresivos y comprometidos con su entorno.
          </p>

          <!-- LÍNEAS DE ACCIÓN -->
          <h5 class="fw-bold mt-5 text-cultura text-center">
            Actividades y clases culturales
          </h5>

          <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle text-center cultura-table">
              <thead class="table-cultura">
                <tr>
                  <th>Categoría</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Clases culturales</td>
                  <td class="text-start">
                    <ul>
                      <li>Danza folclórica</li>
                      <li>Música folclórica</li>
                    </ul>
                  </td>
                </tr>
                <tr>
                  <td>Actividades culturales</td>
                  <td class="text-start">
                    <ul>
                      <li>BU-merang</li>
                      <li>Noche de luna folclórica</li>
                      <li>Maratón bailable</li>
                      <li>Etnoculturízate - Interculturalidad</li>
                      <li>Gestión social y cultural</li>
                      <li>Festival de la canción</li>
                      <li>Talleres de danza</li>
                    </ul>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- IMAGEN DE ACTIVIDADES -->
          <div class="text-center mt-5">
            <img src="/static/img/actividades_cultura.jpg"
              class="img-fluid rounded shadow-sm cultura-actividades-img"
              alt="Actividades culturales">
          </div>

          <!-- SECCIÓN DIVIDIDA EN DOS COLUMNAS -->
          <section class="mt-5 text-center">
            <div class="row gy-5">
              <!-- IZQUIERDA -->
              <div class="col-md-6">
                <h5 class="fw-bold text-cultura mb-3">Clases culturales</h5>
                <ul class="cultura-lista text-start d-inline-block">
                  <li>Danza folclórica</li>
                  <li>Música folclórica</li>
                </ul>
              </div>

              <!-- DERECHA -->
              <div class="col-md-6">
                <h5 class="fw-bold text-cultura mb-3">Actividades culturales</h5>
                <ul class="cultura-lista text-start d-inline-block">
                  <li>BU-merang</li>
                  <li>Noche de luna folclórica</li>
                  <li>Maratón bailable</li>
                  <li>Etnoculturízate - Interculturalidad</li>
                  <li>Gestión social y cultural</li>
                  <li>Festival de la canción</li>
                  <li>Talleres de danza</li>
                </ul>
              </div>
            </div>
          </section>

        </section>
      </main>
    </div>
  </div>
</div>
