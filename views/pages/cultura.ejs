<div class="theme-cultura">
  <div class="container-fluid cultura-page py-4">
    <div class="row gx-5">
      <!-- IMPORTAR SIDEBAR -->
      <div class="col-md-3 col-lg-2">
        <%- include('../partials/sidebar', { activePage: 'cultura' , themeClass: 'theme-cultura' }) %>
      </div>

      <!-- CONTENIDO PRINCIPAL -->
      <main class="col-md-9 col-lg-10 cultura-content">
        <!-- BANNER -->
        <section class="cultura-banner mb-4">
          <img src="/static/img/banner/banner_cultura.jpg" class="img-fluid rounded shadow" alt="Banner Cultura">
        </section>
        <!-- CARRUSEL DE IMÁGENES -->
        <section class="ficha-carousel mb-5">
          <div id="carouselFicha" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">

            <!-- Indicadores -->
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="0" class="active"
                aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="2" aria-label="Slide 3"></button>
              <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="3" aria-label="Slide 4"></button>
              <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="4" aria-label="Slide 5"></button>
            </div>

            <!-- Imágenes -->
            <div class="carousel-inner rounded shadow-sm">
              <div class="carousel-item active">
                <img src="/static/img/cultura/carrusel_cultura/img_1.jpg" class="d-block w-100" alt="Imagen 1">
              </div>
              <div class="carousel-item">
                <img src="/static/img/cultura/carrusel_cultura/img_2.jpg" class="d-block w-100" alt="Imagen 2">
              </div>
              <div class="carousel-item">
                <img src="/static/img/cultura/carrusel_cultura/img_3.jpg" class="d-block w-100" alt="Imagen 3">
              </div>
              <div class="carousel-item">
                <img src="/static/img/cultura/carrusel_cultura/img_4.jpg" class="d-block w-100" alt="Imagen 4">
              </div>
              <div class="carousel-item">
                <img src="/static/img/cultura/carrusel_cultura/img_5.jpg" class="d-block w-100" alt="Imagen 5">
              </div>
            </div>

            <!-- Controles -->
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselFicha" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselFicha" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Siguiente</span>
            </button>
          </div>
        </section>

        <!-- TEXTO PRINCIPAL -->
        <section class="cultura-text">
          <p>
            Desde el eje de Bienestar Integral, en su área de <strong>Cultura</strong>, promovemos el arte y las
            expresiones culturales, a través de actividades y eventos artísticos que fortalecen la identidad cultural,
            la creatividad, la autoestima y las habilidades comunicativas, formando profesionales sensibles, expresivos
            y comprometidos con su entorno.
          </p>

          <!-- IMAGEN DE ACTIVIDADES -->
          <div class="text-center mt-5">
            <img src="/static/img/actividades/actividades_cultura.jpg" class="img-fluid rounded shadow-sm cultura-actividades-img"
              alt="Actividades culturales">
          </div>

          <!-- SECCIÓN DE CLASES Y ACTIVIDADES -->
          <section class="mt-5 text-center">
            <div class="row gy-5">
              <!-- IZQUIERDA -->
              <div class="col-md-6">
                <h5 class="fw-bold text-cultura mb-3 text-center">Clases culturales</h5>

                <div class="row gx-4">
                  <!-- Danza -->
                  <div class="col-md-6">
                    <h5 class="fw-bold text-cultura text-center titulo-sub">Danza folclórica</h5>
                    <p class="text-muted parrafo-cultura">
                      Espacio donde los participantes aprenden y practican diferentes estilos de danzas tradicionales,
                      promoviendo la identidad y la expresión cultural.
                    </p>
                  </div>

                  <!-- Música -->
                  <div class="col-md-6">
                    <h5 class="fw-bold text-cultura text-center titulo-sub">Música folclórica</h5>
                    <p class="text-muted parrafo-cultura">
                      Taller dedicado al aprendizaje de ritmos e instrumentos tradicionales, fortaleciendo las raíces
                      culturales y el trabajo en grupo a través de la música.
                    </p>
                  </div>
                </div>
              </div>

              <!-- DERECHA -->
              <div class="col-md-6">
                <h5 class="fw-bold text-cultura mb-3 text-center">Actividades culturales</h5>
                <ul class="cultura-lista text-start d-inline-block">
                  <li>BU-merang</li>
                  <li>Noche de luna folclórica</li>
                  <li>Maratón bailable</li>
                  <li>Etnoculturízate - Interculturalidad</li>
                  <li>Gestión social y cultural</li>
                  <li>Festival de la canción</li>
                  <li>Talleres de danza</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- VIDEO DE YOUTUBE SHORT -->
          <section class="text-cultura mt-5 text-center">
            <h5 class="fw-bold mb-3">Video de Cultura</h5>
            <div class="video-container mx-auto">
              <iframe src="https://youtube.com/embed/q08MUTPmDPc?si=0TQH-slsj9egybSQ" title="Video de cultura"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
              </iframe>
            </div>
          </section>


        </section>
      </main>
    </div>
  </div>
</div>