<div class="theme-salud">
  <div class="container-fluid salud-page py-4">
    <div class="row gx-5">

      <!-- === SIDEBAR === -->
      <div class="col-md-3 col-lg-2">
        <%- include('../partials/sidebar', { activePage: 'salud' , themeClass: 'theme-salud' }) %>
      </div>

      <!-- === CONTENIDO PRINCIPAL === -->
      <main class="col-md-9 col-lg-10 salud-content">

        <!-- BANNER -->
        <section class="salud-banner mb-4">
          <img src="/static/img/banner_salud.jpg" class="img-fluid rounded shadow" alt="Banner Salud">
        </section>

                        <!-- CARRUSEL DE IMÁGENES -->
                <section class="ficha-carousel mb-5">
                    <div id="carouselFicha" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">

