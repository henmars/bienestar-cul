              <div class="col-md-5">
                <ul class="salud-lista text-start d-inline-block">
                  <li>Asesorías en planificación familiar</li>
                  <li>Jornadas de prevención de ITS y embarazos no deseados</li>
                  <li>Campaña de prevención del cáncer de mama</li>
                  <li>Jornadas de salud, belleza y manejo del estrés</li>
                  <li>Nutrición y alimentación saludable</li>
                </ul>
              </div>
              <div class="col-md-5">
                <ul class="salud-lista text-start d-inline-block">
                  <li>Tamizaje cardiovascular</li>
                  <li>Prevención del consumo de sustancias psicoactivas</li>
                  <li>Charlas de prevención y promoción de salud mental</li>
                  <li>Espacios de escucha</li>
                  <li>Primeros auxilios psicológicos</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- SERVICIOS Y ATENCIÓN EN SALUD -->
          <section class="mt-5 text-center">
            <h5 class="fw-bold text-salud mb-3">Servicios y atención en salud</h5>
            <div class="row justify-content-center mt-3">
              <div class="col-md-5">
                <ul class="salud-lista text-start d-inline-block">
                  <li>Asesorías médicas</li>
                  <li>Asesorías y acompañamiento psicológico</li>
                  <li>Atención por área protegida (AMI)</li>
                </ul>
              </div>
              <div class="col-md-5">
                <ul class="salud-lista text-start d-inline-block">
                  <li>Atención por cobertura de seguro estudiantil (HDI Seguros)</li>
                  <li>Primeros auxilios en salud</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- CÓDIGO QR DE SERVICIOS -->
          <section class="salud-qr-container mt-5 text-center">
            <h5 class="fw-bold text-salud mb-4">
              Escanea estos QR si requieres de nuestros servicios
