          <!-- CONTACTO -->
          <section class="mt-5 text-center">
            <h5 class="fw-bold text-salud mb-3">Contacto de Bienestar Integral</h5>
            <p class="fs-5 text-center">
              <i class="bi bi-telephone-fill text-salud me-2"></i>
              WhatsApp
              <a href="https://wa.me/573205321849" class="text-salud text-decoration-none fw-semibold" target="_blank"
                rel="noopener noreferrer">
                320 532 1849
              </a>
            </p>
