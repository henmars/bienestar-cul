                            <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="2"
                                aria-label="Slide 3"></button>
                            <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="3"
                                aria-label="Slide 4"></button>
                            <button type="button" data-bs-target="#carouselFicha" data-bs-slide-to="4"
                                aria-label="Slide 5"></button>
                        </div>

                        <!-- Imágenes -->
                        <div class="carousel-inner rounded shadow-sm">
                            <div class="carousel-item active">
                                <img src="/static/img/salud/carrusel_salud/img_1.jpg" class="d-block w-100"
                                    alt="Imagen 1">
                            </div>
                            <div class="carousel-item">
                                <img src="/static/img/salud/carrusel_salud/img_2.jpg" class="d-block w-100"
