                            </div>
                            <div class="carousel-item">
                                <img src="/static/img/salud/carrusel_salud/img_3.jpg" class="d-block w-100"
                                    alt="Imagen 3">
                            </div>
                            <div class="carousel-item">
                                <img src="/static/img/salud/carrusel_salud/img_4.jpg" class="d-block w-100"
                                    alt="Imagen 4">
                            </div>
                            <div class="carousel-item">
                                <img src="/static/img/salud/carrusel_salud/img_5.jpg" class="d-block w-100"
                                    alt="Imagen 5">
                            </div>
                        </div>

                        <!-- Controles -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselFicha"
                            data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselFicha"
