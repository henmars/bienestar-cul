<div class="theme-permanencia">
  <div class="container-fluid permanencia-page py-4">
    <div class="row gx-5">

      <!-- === SIDEBAR === -->
      <div class="col-md-3 col-lg-2">
        <%- include('../partials/sidebar', { activePage: 'permanencia' , themeClass: 'theme-permanencia' }) %>
      </div>

      <!-- === CONTENIDO PRINCIPAL === -->
      <main class="col-md-9 col-lg-10 permanencia-content">

        <!-- BANNER -->
        <section class="permanencia-banner mb-4">
          <img src="/static/img/banner/banner_permanencia_y_graduacion.jpg" class="img-fluid rounded shadow"
            alt="Banner Permanencia">
        </section>

        <!-- TEXTO PRINCIPAL -->
        <section class="permanencia-text">
          <p>
            El eje estratégico de Permanencia y Graduación es un proceso que vincula estrategias, acciones y servicios
            que buscan disminuir el riesgo de deserción y mejorar la tasa de graduación de la comunidad estudiantil. Así
            mismo, facilita el proceso de formación del estudiante ya que fortalece la gestión académica, mejora su
            calidad de vida, contribuye al desarrollo integral y apunta a la sostenibilidad de cada uno de los programas
            académicos de la institución.
          </p>

          <!-- TABLA DE LÍNEAS DE ACCIÓN Y ESTRATEGIAS -->
          <h5 class="fw-bold mt-5 permanencia-text text-center">
            Líneas de acción y estrategias del eje estratégico de Permanencia y Graduación
          </h5>
          <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle text-center permanencia-table">
              <thead class="table-warning">
                <tr>
                  <th>Línea de acción</th>
                  <th>Estrategias</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Adaptación y Formación Integral</td>
                  <td class="text-start">
                    <ul>
                      <li>Vinculación e inducción</li>
                      <li>Espacios de interacción y formación</li>
                      <li>Orientación educativa</li>
                    </ul>
                  </td>
                </tr>
                <tr>
                  <td>Desarrollo Humano y Calidad de Vida</td>
                  <td class="text-start">
                    <ul>
                      <li>Promoción del bienestar personal, familiar y social</li>
                    </ul>
                  </td>
                </tr>
                <tr>
                  <td>Evaluación de la Deserción y Graduación</td>
                  <td class="text-start">
                    <ul>
                      <li>Deserción</li>
                      <li>Graduación</li>
                      <li>Reintegro</li>
                    </ul>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- IMAGEN DE ACTIVIDADES -->
          <div class="text-center mt-5">
            <img src="/static/img/actividades/actividades_permanencia_y_graduacion.png"
              class="img-fluid rounded shadow-sm permanencia-actividades-img" alt="Actividades de Permanencia">
          </div>

          <!-- LISTA DE ACTIVIDADES EN DOS COLUMNAS -->
          <section class="mt-4 text-center">
            <div class="row justify-content-center permanencia-actividades-lista mt-3">
              <div class="col-md-5">
                <ul class="permanencia-lista text-start d-inline-block">
                  <li>Entrevista de admisión</li>
                  <li>Inducción de estudiantes nuevos</li>
                  <li>Preparación a la vida laboral</li>
                  <li>Taller realización hoja de vida</li>
                  <li>Taller de pánico escénico</li>
                  <li>Simulacro de entrevista</li>
                </ul>
              </div>
              <div class="col-md-5">
                <ul class="permanencia-lista text-start d-inline-block">
                  <li>Cultura financiera</li>
                  <li>Reintegro estudiantil</li>
                  <li>Seguimiento a convenios y beneficiarios</li>
                  <li>Cursos complementarios con el SENA</li>
                  <li>Monitorías académicas</li>
                  <li>Campañas de sensibilización en valores</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- NÚCLEO FAMILIAR -->
          <section class="mt-5 text-center">
            <h5 class="fw-bold permanencia-text mb-3">Núcleo Familiar</h5>
            <p class="text-justify mx-auto" style="max-width: 800px;">
              Es una línea de acción que promueve la participación activa de las familias en el proceso formativo de los
              estudiantes, fortaleciendo los lazos de apoyo y acompañamiento que favorecen su bienestar emocional,
              académico y social.
            </p>

            <div class="row justify-content-center mt-4">
              <div class="col-md-5">
                <ul class="permanencia-lista text-start d-inline-block">
                  <li>Asesorías psicológicas</li>
                  <li>Inducción a padres de familia</li>
                </ul>
              </div>
              <div class="col-md-5">
                <ul class="permanencia-lista text-start d-inline-block">
                  <li>Vinculación en cursos complementarios</li>
                  <li>Orientación a familiares</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- VIDEO DE YOUTUBE SHORT -->
          <section class="permanencia-text mt-5 text-center">
            <h5 class="fw-bold mb-3">Video de Permanencia y Graduación</h5>
            <div class="video-container mx-auto">
              <iframe src="https://www.youtube.com/embed/BuGv2VPGWxY" title="Video de Permanencia y Graduación"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
              </iframe>
            </div>
          </section>


          <!-- SECCIÓN QR -->
          <section class="permanencia-qr-section mt-5 text-center">
            <h5 class="fw-bold text-permanencia mb-4">Código QR de Permanencia y Graduación</h5>

            <div class="permanencia-qr-card mx-auto">
              <img src="/static/img/qr/qr_permanencia_solicitud_preparacion_vida_laboral.png"
                alt="QR Permanencia y Graduación" class="permanencia-qr-img">
              <p class="mt-2 text-permanencia fw-semibold text-center">
                <i class="bi bi-qr-code-scan me-2"></i><br> Solicitud de asesoría en <br> preparación para la vida
                laboral
              </p>

            </div>
          </section>

        </section>

      </main>
    </div>
  </div>
</div>